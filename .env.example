# quotadeck configuration -- copy to `.env` and edit.
#
# Everything here has a working default; this file exists so that a provider
# changing an endpoint or a public client id does not require a rebuild.
#
# NOTHING IN THIS FILE IS A SECRET.
# quotadeck never stores tokens. Access and refresh tokens are read from your
# own credential files at call time (~/.claude/.credentials.json,
# ~/.local/share/opencode/auth.json, ~/.codex/auth.json, ...) and are
# represented everywhere else by a truncated sha256 fingerprint.
# The two client ids below are PUBLIC OAuth client identifiers for native
# apps: RFC 6749 section 2.1 public clients cannot hold a secret, and both
# values ship in the corresponding open-source CLIs.
#
# `.env` is gitignored regardless, so machine-local overrides stay local.

# --- Anthropic / Claude -----------------------------------------------------
# The usage endpoint is User-Agent gated and expects a claude-cli UA. Bump this
# to match your installed Claude Code if the endpoint starts rejecting calls.
#QUOTADECK_CLAUDE_VERSION=2.1.261
#QUOTADECK_ANTHROPIC_USAGE_URL=https://api.anthropic.com/api/oauth/usage
# Moved from console.anthropic.com in 2025; platform.claude.com also answers.
#QUOTADECK_ANTHROPIC_TOKEN_URL=https://claude.ai/v1/oauth/token
#QUOTADECK_ANTHROPIC_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
#QUOTADECK_ANTHROPIC_OAUTH_BETA=oauth-2025-04-20

# --- OpenAI / Codex ---------------------------------------------------------
#QUOTADECK_OPENAI_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
#QUOTADECK_OPENAI_TOKEN_URL=https://auth.openai.com/oauth/token
#QUOTADECK_OPENAI_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann

# --- Behaviour --------------------------------------------------------------
# Must NOT start with "claude": the Anthropic *token* endpoint rate-limits such
# agents, the exact opposite of what its *usage* endpoint requires.
#QUOTADECK_REFRESH_USER_AGENT=quotadeck/0.1

# Set to 0 to make quotadeck read-only: it will still show credential health
# but will never write to any store.
#QUOTADECK_CUSTODY=1

# Rolling window for local opencode usage, in hours.
#QUOTADECK_WINDOW_HOURS=5

# --- Polling ----------------------------------------------------------------
# localMs reads the local SQLite database and is free.
# quotaMs hits rate-limited provider endpoints -- the Anthropic one allows only
# a handful of calls before 429, usually with no retry-after. Lowering it will
# get you throttled.
#QUOTADECK_POLL_LOCAL_MS=2000
#QUOTADECK_POLL_STORES_MS=15000
#QUOTADECK_POLL_QUOTA_MS=180000
#QUOTADECK_POLL_CUSTODY_MS=300000

# Explicit path to an env file, checked before cwd / exe dir / state dir.
#QUOTADECK_ENV_FILE=
