node_modules/
dist/
release/
# Fully generated by `pnpm run icon`, which `pnpm run dist` always runs first.
build/
*.log

# Local configuration and anything that could carry credentials.
# `.env` holds machine-local overrides only -- see .env.example -- but it is
# excluded unconditionally so a future secret can never be committed by habit.
.env
.env.*
!.env.example

# Credential backups written by custody runs. These DO contain real tokens.
# They normally live in ~/.local/share/quotadeck/backups, but are ignored here
# too in case anyone points the state directory at the working tree.
backups/
*.credentials.json
auth.json
account.json
